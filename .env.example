# Copy to .env and fill in real values (never commit .env)

SECRET_KEY=change-me-to-a-long-random-string

# Google OAuth (Web application) — from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Fix "Error 400: redirect_uri_mismatch"
# -----------------------------------------------------------------------------
# In Google Cloud Console → APIs & Services → Credentials → your OAuth client:
#   Application type: Web application
# Under "Authorized redirect URIs", add EVERY URI you will use (each is different to Google):
#
#   http://127.0.0.1:5000/oauth2callback
#   http://localhost:5000/oauth2callback
#
# Then open the app using the SAME host you registered (if you use 127.0.0.1 in the browser,
# you must have that URI in the console — localhost alone is not enough).
#
# Optional: pin one URI so it never drifts (recommended):
# OAUTH_REDIRECT_URI=http://127.0.0.1:5000/oauth2callback
#
# Production: use your real https origin, e.g.
# OAUTH_REDIRECT_URI=https://yourdomain.com/oauth2callback
# -----------------------------------------------------------------------------

OAUTH_REDIRECT_URI=
